# Voice Desk — every key the project needs. No values.
# Copy to .env and fill in. Never commit .env.

# ---------- Speech: Sarvam (Tamil / Hindi / English, Indian telephony) ----------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
# Set language explicitly. Do NOT rely on the default — saaras:v3 defaults to
# en-IN, not auto-detect. See PROJECT.md 2.4.
SARVAM_DEFAULT_LANGUAGE=ta-IN

# ---------- Speech: ElevenLabs (DEMO ONLY) ----------
# Not the production stack. Sarvam above is (PROJECT.md D1) and is not built
# yet; this exists so `voicedesk.demo.server` can be heard in a human voice
# instead of the browser's synthesiser.
#
# Optional. Without a key the demo falls back to browser speech and labels
# itself as doing so. Never let a demo voice imply the pipeline is finished.
#
# VOICE_ID: any voice from elevenlabs.io/app/voices. The default is "Sarah",
# a stock voice on every account.
# MODEL: eleven_multilingual_v2 handles Tamil and Hindi. eleven_turbo_v2_5 is
# faster and thinner; eleven_flash_v2_5 is faster still. Latency is what a
# caller experiences as competence, so measure before choosing.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------- Reasoning ----------
# Which provider answers. "google" or "openrouter".
# A seam, not a preference: G7 requires a provider fallback, and the first time
# it was needed was not a drill -- AI Studio refused the project with a 403 that
# no configuration could fix. Switching is this line, nothing else.
LLM_PROVIDER=google

# ---------- OpenRouter (one key, many providers, no Google billing) ----------
# Free models exist -- anything ending ':free'. They rate-limit hard and vary in
# tool-calling reliability, which matters here because the agent lives on tool
# calls. Try a paid-but-cheap model if free ones flail.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# ---------- Reasoning: Gemini via Google AI Studio ----------
# Vertex AI is a standing org-wide block. Keep this false.
GOOGLE_AI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
# 2.5-flash was retired for new keys on/before 2026-08-20; the API now
# points at 3.6-flash. Change this rather than the code when it moves again.
GEMINI_MODEL=gemini-3.6-flash

# ---------- Fallback providers (G7 requires a provider fallback) ----------
DEEPGRAM_API_KEY=
FALLBACK_STT_ENABLED=false

# ---------- Telephony (inbound DID only — no dialer credential in v1) ----------
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_INBOUND_DID=
# Exotel alternative
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# ---------- Data (Supabase, India region — DPDP residency) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Must stay ap-south-1. config.py refuses to start on any other value --
# compute may sit outside India (Railway has no India region), storage may not.
SUPABASE_REGION=ap-south-1
# Direct Postgres connection for the scheduling adapter. Connect as the
# `voicedesk_agent` role, NOT as the owner: an owner bypasses row-level
# security, which would make every policy in 0002 silently inert.
# PostgresAdapter.connect() refuses to start if it detects otherwise.
DATABASE_DSN=postgresql://voicedesk_agent@host:5432/postgres

# ---------- Tenant ----------
# All clinic identity lives in config files, never in code.
TENANT_CONFIG_PATH=./config/tenants
DEFAULT_CLINIC_ID=

# ---------- Safety rails (G7) ----------
DRY_RUN=true
KILL_SWITCH=false
MAX_COST_PER_CALL_INR=25
MAX_COST_PER_DAY_INR=2000
MAX_TURNS_PER_CALL=40
MAX_CALL_DURATION_SEC=420
BOOKING_UNDO_WINDOW_SEC=900

# ---------- Compliance ----------
RECORDING_RETENTION_DAYS=90
CONSENT_STORE=local
AI_DISCLOSURE_ENABLED=true

# ---------- Observability ----------
LOG_LEVEL=INFO
TRACE_SAMPLE_RATE=1.0
ALERT_WEBHOOK_URL=
