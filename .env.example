# Voice Desk — every key the project needs. No values.
# Copy to .env and fill in. Never commit .env.

# ---------- Speech: Sarvam (Tamil / Hindi / English, Indian telephony) ----------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
# Set language explicitly. Do NOT rely on the default — saaras:v3 defaults to
# en-IN, not auto-detect. See PROJECT.md 2.4.
SARVAM_DEFAULT_LANGUAGE=ta-IN

# ---------- Reasoning: Gemini via Google AI Studio ----------
# Vertex AI is a standing org-wide block. Keep this false.
GOOGLE_AI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-2.5-flash

# ---------- Fallback providers (G7 requires a provider fallback) ----------
DEEPGRAM_API_KEY=
FALLBACK_STT_ENABLED=false

# ---------- Telephony (inbound DID only — no dialer credential in v1) ----------
TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_INBOUND_DID=
# Exotel alternative
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# ---------- Data (Supabase, India region — DPDP residency) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_REGION=ap-south-1

# ---------- Tenant ----------
# All clinic identity lives in config files, never in code.
TENANT_CONFIG_PATH=./config/tenants
DEFAULT_CLINIC_ID=

# ---------- Safety rails (G7) ----------
DRY_RUN=true
KILL_SWITCH=false
MAX_COST_PER_CALL_INR=25
MAX_COST_PER_DAY_INR=2000
MAX_TURNS_PER_CALL=40
MAX_CALL_DURATION_SEC=420
BOOKING_UNDO_WINDOW_SEC=900

# ---------- Compliance ----------
RECORDING_RETENTION_DAYS=90
CONSENT_STORE=local
AI_DISCLOSURE_ENABLED=true

# ---------- Observability ----------
LOG_LEVEL=INFO
TRACE_SAMPLE_RATE=1.0
ALERT_WEBHOOK_URL=
