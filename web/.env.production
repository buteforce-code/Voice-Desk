# The live demo backend on Railway.
#
# Committed on purpose. It is a public URL, not a secret -- the thing that
# stops other sites spending our credits is DEMO_ALLOWED_ORIGINS on the
# backend, not the obscurity of this value.
#
# Committing it means a fresh Vercel project builds correctly with no
# dashboard step. Setting NEXT_PUBLIC_API_BASE in Vercel overrides it.
NEXT_PUBLIC_API_BASE=https://demo-production-5766.up.railway.app
